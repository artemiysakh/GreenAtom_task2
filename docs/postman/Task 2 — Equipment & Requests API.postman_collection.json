{
  "info": {
    "_postman_id": "b1a2c3d4-0001-4000-8000-000000000001",
    "name": "Task 2 — Equipment & Requests API (clean)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Генерируется один раз на весь прогон коллекции",
          "if (!pm.collectionVariables.get('runId')) {",
          "  pm.collectionVariables.set('runId', Date.now().toString(36) + Math.random().toString(36).slice(2, 8));",
          "}",
          "const runId = pm.collectionVariables.get('runId');",
          "// Уникальный serial для этого прогона",
          "if (!pm.collectionVariables.get('serialNumber')) {",
          "  pm.collectionVariables.set('serialNumber', `WT-${runId}`.toUpperCase());",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "GET /api/health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('status is ok', () => pm.expect(j.status).to.eql('ok'));",
                  "pm.test('has uptime', () => pm.expect(j).to.have.property('uptime'));",
                  "pm.test('has timestamp', () => pm.expect(j).to.have.property('timestamp'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Equipment",
      "item": [
        {
          "name": "POST create equipment (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('has data.id', () => pm.expect(j.data).to.have.property('id'));",
                  "pm.test('id is uuid', () => pm.expect(j.data.id).to.match(/^[0-9a-f-]{36}$/i));",
                  "pm.test('has Location header', () => pm.expect(pm.response.headers.get('Location')).to.include('/api/equipment/'));",
                  "pm.test('has createdAt', () => pm.expect(j.data).to.have.property('createdAt'));",
                  "pm.test('has updatedAt', () => pm.expect(j.data).to.have.property('updatedAt'));",
                  "pm.test('serialNumber matches', () => pm.expect(j.data.serialNumber).to.eql(pm.collectionVariables.get('serialNumber')));",
                  "",
                  "pm.collectionVariables.set('equipmentId', j.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Turbine Alpha\",\n  \"type\": \"turbine\",\n  \"serialNumber\": \"{{serialNumber}}\",\n  \"location\": { \"lat\": 55.75, \"lon\": 37.62 },\n  \"status\": \"operational\",\n  \"installedAt\": \"2023-05-12T10:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/equipment",
              "host": ["{{baseUrl}}"],
              "path": ["api", "equipment"]
            }
          },
          "response": []
        },
        {
          "name": "POST duplicate serialNumber (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "const j = pm.response.json();",
                  "pm.test('code is CONFLICT', () => pm.expect(j.error.code).to.eql('CONFLICT'));",
                  "pm.test('has requestId', () => pm.expect(j.error).to.have.property('requestId'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Duplicate\",\n  \"type\": \"turbine\",\n  \"serialNumber\": \"{{serialNumber}}\",\n  \"location\": { \"lat\": 55.75, \"lon\": 37.62 },\n  \"status\": \"operational\",\n  \"installedAt\": \"2023-05-12T10:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/equipment",
              "host": ["{{baseUrl}}"],
              "path": ["api", "equipment"]
            }
          },
          "response": []
        },
        {
          "name": "POST invalid body (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 422', () => pm.response.to.have.status(422));",
                  "const j = pm.response.json();",
                  "pm.test('code is VALIDATION_ERROR', () => pm.expect(j.error.code).to.eql('VALIDATION_ERROR'));",
                  "pm.test('details is array', () => pm.expect(j.error.details).to.be.an('array'));",
                  "pm.test('details not empty', () => pm.expect(j.error.details.length).to.be.above(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"X\",\n  \"type\": \"rocket\",\n  \"serialNumber\": \"\",\n  \"location\": { \"lat\": 999, \"lon\": 999 },\n  \"status\": \"unknown\",\n  \"installedAt\": \"2999-01-01T00:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/equipment",
              "host": ["{{baseUrl}}"],
              "path": ["api", "equipment"]
            }
          },
          "response": []
        },
        {
          "name": "GET list with filters + pagination (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('data is array', () => pm.expect(j.data).to.be.an('array'));",
                  "pm.test('meta.total exists', () => pm.expect(j.meta).to.have.property('total'));",
                  "pm.test('meta.page is 1', () => pm.expect(j.meta.page).to.eql(1));",
                  "pm.test('meta.limit is 5', () => pm.expect(j.meta.limit).to.eql(5));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/equipment?type=turbine&status=operational&page=1&limit=5&sortBy=name&order=asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "equipment"],
              "query": [
                { "key": "type", "value": "turbine" },
                { "key": "status", "value": "operational" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "5" },
                { "key": "sortBy", "value": "name" },
                { "key": "order", "value": "asc" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET equipment by id (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('data.id matches', () => pm.expect(j.data.id).to.eql(pm.collectionVariables.get('equipmentId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/equipment/{{equipmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "equipment", "{{equipmentId}}"]
            }
          },
          "response": []
        },
        {
          "name": "PATCH equipment valid (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('name changed', () => pm.expect(j.data.name).to.eql('Turbine Updated'));",
                  "pm.test('id unchanged', () => pm.expect(j.data.id).to.eql(pm.collectionVariables.get('equipmentId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Turbine Updated\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/equipment/{{equipmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "equipment", "{{equipmentId}}"]
            }
          },
          "response": []
        },
        {
          "name": "GET equipment weather (200 or 502)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 or 502', () => pm.expect([200, 502]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.test('has forecast', () => pm.expect(j.data).to.have.property('forecast'));",
                  "  pm.test('has suitable', () => pm.expect(j.data).to.have.property('suitable'));",
                  "} else {",
                  "  const j = pm.response.json();",
                  "  pm.test('error is EXTERNAL_SERVICE_ERROR', () => pm.expect(j.error.code).to.eql('EXTERNAL_SERVICE_ERROR'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/equipment/{{equipmentId}}/weather",
              "host": ["{{baseUrl}}"],
              "path": ["api", "equipment", "{{equipmentId}}", "weather"]
            }
          },
          "response": []
        }
      ]
    },
