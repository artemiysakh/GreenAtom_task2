            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"X\",\n  \"type\": \"rocket\",\n  \"serialNumber\": \"\",\n  \"location\": { \"lat\": 999, \"lon\": 999 },\n  \"status\": \"unknown\",\n  \"installedAt\": \"2999-01-01T00:00:00.000Z\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/equipment", "host": ["{{baseUrl}}"], "path": ["api", "equipment"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('status 422', () => pm.response.to.have.status(422));",
                "const j = pm.response.json();",
                "pm.test('code is VALIDATION_ERROR', () => pm.expect(j.error.code).to.eql('VALIDATION_ERROR'));",
                "pm.test('details is array', () => pm.expect(j.error.details).to.be.an('array'));",
                "pm.test('details not empty', () => pm.expect(j.error.details.length).to.be.above(0));",
                "pm.test('each detail has field & message', () => {",
                "  j.error.details.forEach(d => {",
                "    pm.expect(d).to.have.property('field');",
                "    pm.expect(d).to.have.property('message');",
                "  });",
                "});"
              ]
            }
          }]
        },
