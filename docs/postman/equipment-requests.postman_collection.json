      "item": [
        {
          "name": "GET unknown route (404)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/unknown", "host": ["{{baseUrl}}"], "path": ["api", "unknown"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('status 404', () => pm.response.to.have.status(404));",
                "const j = pm.response.json();",
                "pm.test('code is NOT_FOUND', () => pm.expect(j.error.code).to.eql('NOT_FOUND'));",
                "pm.test('has requestId', () => pm.expect(j.error).to.have.property('requestId'));"
              ]
            }
          }]
        }
      ]
    }
  ]
}