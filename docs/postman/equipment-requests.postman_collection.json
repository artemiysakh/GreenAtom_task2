  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('status 200', () => pm.response.to.have.status(200));",
                "const j = pm.response.json();",
                "pm.test('status is ok', () => pm.expect(j.status).to.eql('ok'));",
                "pm.test('has uptime', () => pm.expect(j).to.have.property('uptime'));",
                "pm.test('has timestamp', () => pm.expect(j).to.have.property('timestamp'));"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "2. Equipment",
      "item": [
        {
          "name": "POST create equipment (201)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Turbine Alpha\",\n  \"type\": \"turbine\",\n  \"serialNumber\": \"WT-UNIQUE-001\",\n  \"location\": { \"lat\": 55.75, \"lon\": 37.62 },\n  \"status\": \"operational\",\n  \"installedAt\": \"2023-05-12T10:00:00.000Z\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/equipment", "host": ["{{baseUrl}}"], "path": ["api", "equipment"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('status 201', () => pm.response.to.have.status(201));",
                "const j = pm.response.json();",
                "pm.test('has data.id', () => pm.expect(j.data).to.have.property('id'));",
                "pm.test('id is uuid', () => pm.expect(j.data.id).to.match(/^[0-9a-f-]{36}$/i));",
                "pm.test('has Location header', () => pm.expect(pm.response.headers.get('Location')).to.include('/api/equipment/'));",
                "pm.test('has createdAt', () => pm.expect(j.data).to.have.property('createdAt'));",
                "pm.test('has updatedAt', () => pm.expect(j.data).to.have.property('updatedAt'));",
                "pm.test('serialNumber matches', () => pm.expect(j.data.serialNumber).to.eql('WT-UNIQUE-001'));",
                "",
                "pm.environment.set('equipmentId', j.data.id);",
                "pm.environment.set('serialNumber', j.data.serialNumber);"
              ]
            }
          }]
        },
        {
          "name": "POST duplicate serialNumber (409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Duplicate\",\n  \"type\": \"turbine\",\n  \"serialNumber\": \"{{serialNumber}}\",\n  \"location\": { \"lat\": 55.75, \"lon\": 37.62 },\n  \"status\": \"operational\",\n  \"installedAt\": \"2023-05-12T10:00:00.000Z\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/equipment", "host": ["{{baseUrl}}"], "path": ["api", "equipment"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('status 409', () => pm.response.to.have.status(409));",
                "const j = pm.response.json();",
                "pm.test('code is CONFLICT', () => pm.expect(j.error.code).to.eql('CONFLICT'));",
                "pm.test('has requestId', () => pm.expect(j.error).to.have.property('requestId'));"
              ]
            }
          }]
        },
        {
          "name": "POST invalid body (422)",
